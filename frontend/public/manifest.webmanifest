      "url": "/rooms",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Explore Map",
      "short_name": "Map",
      "description": "Browse rooms on the interactive Dhaka map",
      "url": "/map",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Post Listing",
      "short_name": "List",
