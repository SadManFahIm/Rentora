    },
    {
      "src": "/icons/maskable-dark-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Search Rooms",
      "short_name": "Search",
