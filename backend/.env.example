DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — leave DB_ENGINE unset (or "sqlite") to use SQLite for local dev.
# Set DB_ENGINE=postgres and fill these in to use PostgreSQL instead.
DB_ENGINE=sqlite
DB_NAME=rentora
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Channels + cache backend — defaults to in-memory (fine for a single dev
# process). Set CHANNELS_BACKEND=redis to use Redis for both the WebSocket
# channel layer and the Django cache (needed for chat online-presence
# tracking to work correctly across multiple processes/workers).
CHANNELS_BACKEND=
REDIS_URL=redis://localhost:6379/0

# SSLCommerz — SANDBOX credentials only, never production keys. Register
# your own free sandbox merchant account at
# https://developer.sslcommerz.com/registration/ or use their shared demo
# sandbox store (testbox / qwerty) for quick local testing.
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
SSLCOMMERZ_SANDBOX=True

# bKash Tokenized Checkout — SANDBOX credentials only, never production keys.
# Values below are bKash's own published shared sandbox test credentials
# (see developer.bka.sh); register your own sandbox app when approved.
BKASH_APP_KEY=4f6o0cjiki2rfm34kfdadl1eqq
BKASH_APP_SECRET=2is7hdktrekvrbljjh44ll3d9l1dtjo4pasmjvs5vl5qr3fug4b
BKASH_USERNAME=sandboxTokenizedUser02
BKASH_PASSWORD=sandboxTokenizedUser02@12345
BKASH_SANDBOX_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

# Frontend base URL — used to redirect the browser after a bKash callback.
FRONTEND_URL=http://localhost:3000

# -------------------------------------------------------------
# Phase 9 — Reliability & observability
# -------------------------------------------------------------
# Celery broker — LEAVE EMPTY for eager (synchronous) mode: tasks run inline
# with no Redis, perfect for local dev and tests. Set a real broker to enable
# async workers + the beat schedule:
#   CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_BROKER_URL=

# Sentry error tracking — leave empty to disable (no events sent).
SENTRY_DSN=
SENTRY_ENV=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Structured JSON logs to stdout (one JSON object per line).
JSON_LOGS=False

# Transactional email sender name (used in email templates).
SITE_NAME=Rentora

# -------------------------------------------------------------
# Phase 13 — SMS OTP login (phone sign-in)
# -------------------------------------------------------------
# OFF by default. Set SMS_OTP_ENABLED=True once an SMS gateway is configured.
#   SMS_PROVIDER=console logs codes to the server log (local dev / CI, zero
#   config). SMS_PROVIDER=http POSTs the generic gateway below — plug in a
#   real provider (Twilio / GreenWeb / bKash SMS API) behind the same
#   users.sms provider contract.
SMS_OTP_ENABLED=False
SMS_PROVIDER=console
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=
SMS_OTP_TTL_SECONDS=600
SMS_OTP_MAX_ATTEMPTS=5
SMS_OTP_RESEND_COOLDOWN_SECONDS=30

# -------------------------------------------------------------
# Phase 14 — Vision & content AI (AI v3)
# -------------------------------------------------------------
# Deterministic, self-hosted photo pipeline — on by default (no external
# calls). VISION_PROVIDER=http additionally POSTs listing photos to a vision
# gateway (e.g. an OpenAI-compatible captioning endpoint) for a caption +
# object-level amenity tags; any gateway failure falls back to heuristic.
VISION_ENABLED=True
VISION_PROVIDER=heuristic
VISION_GATEWAY_URL=
VISION_GATEWAY_API_KEY=
VISION_GATEWAY_MODEL=
VISION_SEARCH_TOP_K=8

# -------------------------------------------------------------
# Phase 15 — Chat live translation EN⇄BN (B1)
# -------------------------------------------------------------
# Deterministic phrase-table core — on by default (no external calls).
# CHAT_TRANSLATE_PROVIDER=http additionally POSTs text to a machine-translation
# gateway (any OpenAI-compatible /translate endpoint) and falls back to the
# phrase core on failure. The phrase core also re-reads Bengali chat messages
# inside the safety engine's cross-lingual scan (never via the gateway).
CHAT_TRANSLATE_ENABLED=True
CHAT_TRANSLATE_PROVIDER=phrase
CHAT_TRANSLATE_GATEWAY_URL=
CHAT_TRANSLATE_GATEWAY_API_KEY=

# -------------------------------------------------------------
# Phase 15 — KYC OCR auto-extract (C4)
# -------------------------------------------------------------
# OCR layer runs on every NID upload (stores extracted fields in the admin
# review detail) but extracts nothing until an OCR gateway is wired up.
# KYC_OCR_PROVIDER=http POSTs the document image (multipart field "file") to
# the gateway and expects {"text": "..."}; parsed fields are structural
# format checks only — never identity proof.
KYC_OCR_ENABLED=True
KYC_OCR_PROVIDER=none
KYC_OCR_GATEWAY_URL=
KYC_OCR_GATEWAY_API_KEY=

# -------------------------------------------------------------
# Phase 15 — Rental market report (C6)
# -------------------------------------------------------------
# Weekly per-area price/demand digest (public read endpoint + Monday beat
# task). The snapshot is always written; this master switch only gates the
# subscriber emails.
MARKET_REPORT_ENABLED=True

# -------------------------------------------------------------
# Phase 16 — Hardening & scale
# -------------------------------------------------------------
# Embeddings / vector search — off by default (requires pgvector in prod).
# Set EMBEDDING_PROVIDER=lite for the local TF-IDF fallback, or =openai
# / =huggingface for remote embedding APIs.
EMBEDDING_PROVIDER=lite
EMBEDDING_DIMENSIONS=384
VECTOR_SEARCH_ENABLED=False
VECTOR_SEARCH_TOP_K=8

# Auto-index rooms into the embedding store on save (needs a real broker).
EMBEDDING_INDEX_ON_SAVE=

# Image pipeline — WebP variant generation + upload hardening.
IMAGE_MAX_PIXELS=100000000
IMAGE_MIN_DIMENSION=128
IMAGE_MAX_DIMENSION=8000
MAX_ROOM_IMAGES=10
MEDIA_PRIVATE_ROOT=

# Trusted proxy count for X-Forwarded-For resolution (see config/ip.py).
# 0 = ignore XFF entirely (direct access); 1 = one LB in front.
NUM_PROXIES=0

# Chat presence lease TTL (seconds). Consumers heartbeat every 60 s; a
# lease older than this is considered dead, self-healing after a worker crash.
PRESENCE_CONNECTION_TTL=180

# Application version string exposed in the health check endpoint.
APP_VERSION=dev

# Analytics event retention (days). Events older than this are purged daily
# by the analytics.tasks.purge_expired_events Celery beat task (Phase 16 S8).
ANALYTICS_EVENT_RETENTION_DAYS=365
